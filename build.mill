//| mill-jvm-version: system|25
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
package build
import mill.*
import mill.scalalib.*
import mill.api.Task
import mill.util.VcsVersion

import com.goyeau.mill.scalafix.ScalafixModule

object Versions {
  def scala3            = "3.9.0"
  def javaOutputVersion = "17" // JVM the library must run on (built with a more recent JDK)
  def coursier          = "2.1.27"
  def jsoniterScala     = "2.43.0"
  def sttp              = "3.11.0"
  def munit             = "1.3.6"
}

object `scala-publish` extends Publish

object Deps {
  // coursier-cache depends on Scala CLI's config module, but none of its classes used here (nor the
  // ones of coursier-core / coursier-util / coursier-paths) reference it. Excluding it keeps a
  // published copy of Scala CLI's own module off the class path of users, Scala CLI included.
  def coursierCache = mvn"io.get-coursier::coursier-cache:${Versions.coursier}"
    .exclude("org.virtuslab.scala-cli" -> "config_3")
  def coursierCore = mvn"io.get-coursier::coursier-core:${Versions.coursier}"
  def jsoniterCore =
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core:${Versions.jsoniterScala}"
  def jsoniterMacros =
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros:${Versions.jsoniterScala}"
  def sttp  = mvn"com.softwaremill.sttp.client3::core:${Versions.sttp}"
  def munit = mvn"org.scalameta::munit::${Versions.munit}"
}

trait Publish extends ScalaModule with Published with ScalafixModule {
  def scalaVersion: T[String]                = Versions.scala3
  override def scalacOptions: T[Seq[String]] = Task {
    super.scalacOptions() ++ Seq(
      "-Wunused:all",
      "-deprecation",
      "-Werror",
      "-java-output-version",
      Versions.javaOutputVersion
    )
  }

  def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
    Deps.coursierCache,
    Deps.coursierCore,
    Deps.jsoniterCore,
    Deps.sttp
  )
  def compileMvnDeps: T[Seq[Dep]] = super.compileMvnDeps() ++ Seq(
    Deps.jsoniterMacros
  )
  def javacOptions: T[Seq[String]] = super.javacOptions() ++ Seq(
    "--release",
    Versions.javaOutputVersion
  )

  /** Generates `scala.publish.util.BuildInfo`, giving the library version at runtime (used in the
    * User-Agent of HTTP requests). Doesn't rely on `git describe`, unlike [[publishVersion]] on the
    * CI, which fails when no tag can be found.
    */
  def generatedSources: T[Seq[PathRef]] = Task {
    val version = computePublishVersion(VcsVersion.vcsState(), simple = true)
    os.write(
      Task.dest / "BuildInfo.scala",
      s"""package scala.publish.util
         |
         |/** Information about this build of scala-publish, generated by the build */
         |private[publish] object BuildInfo {
         |  val version: String = "$version"
         |}
         |""".stripMargin
    )
    super.generatedSources() ++ Seq(PathRef(Task.dest))
  }

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
      Deps.munit
    )
  }
}

def publishOrg: String = "org.scala-lang"
def ghOrg: String      = "scala"
def ghName: String     = "scala-publish"

trait Published extends SonatypeCentralPublishModule {
  import mill.scalalib.publish.*
  def pomSettings: T[PomSettings] = PomSettings(
    description = artifactName(),
    organization = publishOrg,
    url = s"https://github.com/$ghOrg/$ghName",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github(ghOrg, ghName),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault"),
      Developer("Gedochao", "Piotr Chabelski", "https://github.com/Gedochao"),
      Developer("tgodzik", "Tomasz Godzik", "https://github.com/tgodzik")
    )
  )
  def publishVersion: T[String] = finalPublishVersion()
}

private def computePublishVersion(state: VcsVersion.State, simple: Boolean): String =
  if state.commitsSinceLastTag > 0 then
    if simple then {
      val versionOrEmpty = state.lastTag
        .filter(_ != "latest")
        .filter(_ != "nightly")
        .map(_.stripPrefix("v"))
        .flatMap { tag =>
          if simple then {
            val idx = tag.lastIndexOf(".")
            if idx >= 0 then
              Some(tag.take(idx + 1) + (tag.drop(idx + 1).toInt + 1).toString + "-SNAPSHOT")
            else None
          }
          else {
            val idx = tag.indexOf("-")
            if idx >= 0 then Some(tag.take(idx) + "+" + tag.drop(idx + 1) + "-SNAPSHOT") else None
          }
        }
        .getOrElse("0.0.1-SNAPSHOT")
      Some(versionOrEmpty)
        .filter(_.nonEmpty)
        .getOrElse(state.format())
    }
    else {
      val rawVersion = os.proc("git", "describe", "--tags").call().out.text().trim
        .stripPrefix("v")
        .replace("latest", "0.0.0")
        .replace("nightly", "0.0.0")
      val idx = rawVersion.indexOf("-")
      if idx >= 0 then rawVersion.take(idx) + "+" + rawVersion.drop(idx + 1) + "-SNAPSHOT"
      else rawVersion
    }
  else {
    val fromTag = state
      .lastTag
      .getOrElse(state.format())
      .stripPrefix("v")
    if fromTag == "0.0.0" then "0.0.1-SNAPSHOT"
    else fromTag
  }

def finalPublishVersion: T[String] = {
  val isCI = System.getenv("CI") != null
  if isCI then
    Task(persistent = true) {
      val state = VcsVersion.vcsState()
      computePublishVersion(state, simple = false)
    }
  else
    Task {
      val state = VcsVersion.vcsState()
      computePublishVersion(state, simple = true)
    }
}
